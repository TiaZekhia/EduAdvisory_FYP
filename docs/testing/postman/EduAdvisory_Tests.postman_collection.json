            "var withLink = meetings.filter(m => m.meetingLink && m.meetingLink.includes('meet.google.com'));",
            "pm.test('Meeting has Google Meet link', () => pm.expect(withLink.length).to.be.above(0));"
          ]}}],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/student-meetings/my/upcoming",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }]
