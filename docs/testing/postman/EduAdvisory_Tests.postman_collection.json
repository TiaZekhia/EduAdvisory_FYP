    {
      "name": "📚 Course Planning",
      "item": [
        {
          "name": "T5-1 GET Course Plans (Student) — generates 3 plans",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "var json = pm.response.json();",
            "pm.test('At least 1 plan returned', () => pm.expect(json.length).to.be.above(0));",
            "pm.test('Plan has semesters', () => pm.expect(json[0].semesters).to.be.an('array'));",
            "pm.test('Plan has metrics', () => pm.expect(json[0].metrics).to.exist);",
            "console.log('Number of plans:', json.length);",
            "console.log('Strategies:', json.map(p => p.strategy));"
          ]}}],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/Students/me/course-plan/plans?count=3",
              "query": [{ "key": "count", "value": "3" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }]
          },
          "response": [],
          "_expected": "200 — [{planId, strategy:'Balanced'|'FastBlockers'|'StudyGuideStrict', metrics:{creditsRemaining, estimatedGraduationTerm}, semesters:[{plannedSemester, totalCredits, courses:[...]}]}]"
        },
        {
          "name": "T5-2 GET Course Plan AI Insights — AI ranks plans",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "var json = pm.response.json();",
            "var insights = json.insights || json;",
            "pm.test('BestPlanIndex is set', () => pm.expect(insights.bestPlanIndex).to.be.a('number'));",
